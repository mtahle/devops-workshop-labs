name: Deploy to EC2 with Docker Compose

on:
  push:
    branches:
      - main
  workflow_dispatch:

permissions:
  contents: read

jobs:
  deploy:
    runs-on:
      - self-hosted
      - linux
      - x64
      - ec2-prod

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Verify required secrets exist
        env:
          DOCKERHUB_USERNAME: ${{ secrets.DOCKERHUB_USERNAME }}
          DOCKERHUB_TOKEN: ${{ secrets.DOCKERHUB_TOKEN }}
          APP_IMAGE_NAME: ${{ secrets.APP_IMAGE_NAME }}
          APP_PORT: ${{ secrets.APP_PORT }}
          APP_ENV: ${{ secrets.APP_ENV }}
        run: |
          [ -n "$DOCKERHUB_USERNAME" ] || { echo "Missing DOCKERHUB_USERNAME"; exit 1; }
          [ -n "$DOCKERHUB_TOKEN" ] || { echo "Missing DOCKERHUB_TOKEN"; exit 1; }
          [ -n "$APP_IMAGE_NAME" ] || { echo "Missing APP_IMAGE_NAME"; exit 1; }
          [ -n "$APP_PORT" ] || { echo "Missing APP_PORT"; exit 1; }
          [ -n "$APP_ENV" ] || { echo "Missing APP_ENV"; exit 1; }

      - name: Log in to Docker Hub
        uses: docker/login-action@v3
        with:
          username: ${{ secrets.DOCKERHUB_USERNAME }}
          password: ${{ secrets.DOCKERHUB_TOKEN }}

      - name: Prepare deployment environment file
        run: |
          cat > .env.prod <<EOF
          APP_IMAGE=${{ secrets.DOCKERHUB_USERNAME }}/${{ secrets.APP_IMAGE_NAME }}:latest
          APP_PORT=${{ secrets.APP_PORT }}
          APP_ENV=${{ secrets.APP_ENV }}
          EOF

      - name: Pull and deploy with Docker Compose
        run: |
          docker compose -f docker-compose.prod.yml --env-file .env.prod pull
          docker compose -f docker-compose.prod.yml --env-file .env.prod up -d

      - name: Verify running containers
        run: docker compose -f docker-compose.prod.yml --env-file .env.prod ps
